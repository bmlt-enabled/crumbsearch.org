{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crumbsearch-org",
  "compatibility_date": "2026-05-07",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "site"
  },
  // Read by the Pages Function in functions/_middleware.js (unfurl meta injection).
  "vars": {
    "BMLT_SERVER": "https://aggregator.bmltenabled.org/main_server/"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
